{
  "video": {
    "prefix": "video",
    "body": [
      "<video width=\"100%\" controls>",
      "  <source src=\"$1\" type=\"video/mp4\">",
      "</video>"
    ]
  },
  "text": {
    "prefix": "text",
    "body": [
      "```text",
      "$1",
      "```"
    ]
  },
  "BLOG-HEAD": {
    "prefix": "BLOG-HEAD",
    "body": [
      "---",
      "title: $1",
      "date: 2023-11-10 23:00:00 +0800",
      "description: $2",
      "categories: [$3]",
      "tags: [$4]",
      "---",
      "",
      "$0"
    ]
  },
  "header": {
    "body": [
      "---",
      "title: $1",
      "---"
    ],
    "prefix": "header"
  },
  "codeblock": {
    "prefix": "codeblock",
    "body": [
      "```$1",
      "$0",
      "```"
    ]
  },
  "details": {
    "prefix": "details",
    "body": [
      "<details>",
      "",
      "<summary>$1</summary>",
      "",
      "$0",
      "",
      "</details>"
    ]
  }
}
